{
  "name": "@rafu1987/razorbox",
  "version": "0.7.0-alpha.6",
  "description": "Lightweight, dependency-free, Fancybox-inspired image, video, HTML, iframe, maps and PDF lightbox with separate CSS.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafu1987/razorbox.git"
  },
  "homepage": "https://github.com/rafu1987/razorbox#readme",
  "bugs": {
    "url": "https://github.com/rafu1987/razorbox/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/razorbox.js",
  "module": "./dist/razorbox.js",
  "types": "./dist/razorbox.d.ts",
  "exports": {
    ".": {
      "types": "./dist/razorbox.d.ts",
      "import": "./dist/razorbox.js",
      "default": "./dist/razorbox.js"
    },
    "./css": "./dist/razorbox.css",
    "./razorbox.css": "./dist/razorbox.css",
    "./scss": "./src/scss/razorbox.scss",
    "./package.json": "./package.json",
    "./min": {
      "types": "./dist/razorbox.d.ts",
      "import": "./dist/razorbox.min.js",
      "default": "./dist/razorbox.min.js"
    },
    "./css/min": "./dist/razorbox.min.css",
    "./razorbox.min.js": {
      "types": "./dist/razorbox.d.ts",
      "import": "./dist/razorbox.min.js",
      "default": "./dist/razorbox.min.js"
    },
    "./razorbox.min.css": "./dist/razorbox.min.css"
  },
  "files": [
    "dist",
    "src/scss",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --open /demo.html",
    "build": "vite build --mode readable && vite build --mode minified && node scripts/copy-types.mjs",
    "build:demo": "vite build --config vite.demo.config.js",
    "test": "node --test tests/unit/ tests/package.test.mjs",
    "test:unit": "node --test tests/unit/",
    "test:coverage": "c8 --include=\"src/**/*.js\" --check-coverage --lines 95 --branches 90 --reporter=text --reporter=lcov node --test tests/unit/",
    "test:browser": "node --test --test-concurrency=1 tests/browser.test.mjs tests/a11y.test.mjs",
    "lint:js": "standard",
    "lint:js:fix": "standard --fix",
    "lint:css": "stylelint \"src/scss/**/*.scss\"",
    "lint:css:fix": "stylelint \"src/scss/**/*.scss\" --fix",
    "lint:package": "publint --pack npm && attw --pack . --profile esm-only --exclude-entrypoints ./css ./razorbox.css ./scss ./css/min ./razorbox.min.css",
    "release:check": "yarn lint:js && yarn lint:css && yarn test && yarn test:browser && yarn lint:package",
    "release": "np",
    "version": "yarn build && git add dist",
    "prepare": "husky"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "axe-core": "^4.14.0",
    "c8": "^12.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "np": "^12.1.1",
    "publint": "^0.3.25",
    "sass": "^1.90.0",
    "standard": "^17.1.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.2",
    "terser": "^5.39.2",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "lightbox",
    "gallery",
    "vanilla-js",
    "scss",
    "vite",
    "fancybox-alternative",
    "video-lightbox",
    "youtube",
    "vimeo"
  ],
  "standard": {
    "ignore": [
      "dist/",
      "demo-dist/",
      "coverage/"
    ],
    "env": [
      "browser"
    ]
  },
  "np": {
    "message": "Release v%s",
    "testScript": "release:check",
    "branch": "main",
    "publish": false,
    "releaseDraft": false
  },
  "lint-staged": {
    "{src,tests,scripts,demo}/**/*.{js,mjs}": "standard --fix",
    "vite*.config.js": "standard --fix",
    "src/scss/**/*.scss": "stylelint --fix"
  }
}
